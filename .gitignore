# ==========================================
# 1-Click to Campaign - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production & Build outputs
dist/
backend/dist/
frontend/dist/
.angular/
frontend/.angular/
out-tsc/
bazel-out/

# Temporary generated files & media storage
temp/
backend/temp/
frontend/temp/
*.mp4
concat_list.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
coverage/
.sass-cache/
*.tsbuildinfo
